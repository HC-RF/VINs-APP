# =============================================================================
# VIN Decoder — environment configuration
# Copy to `.env` and edit. NEVER commit the real `.env`.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME="VIN Decoder"
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Comma-separated list of origins allowed to call the API from a browser.
# Leave as-is when the frontend is served by this same app.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---------------------------------------------------------------
# PostgreSQL (production / full setup):
#   DATABASE_URL=postgresql+psycopg://vin:vin@localhost:5432/vin_decoder
#
# Leave blank to use the zero-setup SQLite fallback (./vin_decoder.sqlite3).
# The application code, ORM models and repositories are identical either way.
DATABASE_URL=

# Echo every SQL statement to the log. Noisy; debugging only.
DB_ECHO=false

# --- Caching ----------------------------------------------------------------
# Decoded VINs are cached in the database so the same VIN is never paid for
# twice. TTL in hours; 0 disables expiry (cache forever).
CACHE_TTL_HOURS=720               # 30 days
CACHE_ENABLED=true

# --- Provider: NHTSA vPIC (FREE, no API key required) -----------------------
# The default provider. Public US government VIN database.
NHTSA_ENABLED=true
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
NHTSA_TIMEOUT_SECONDS=15

# --- Provider: Local spec catalog (FREE, offline) ---------------------------
# Curated specification data shipped with the app. Used to enrich fields the
# VIN itself cannot carry (horsepower, transmission, MPG) and as an
# independent source for cross-verification.
SPEC_CATALOG_ENABLED=true

# --- Provider: Auto.dev (COMMERCIAL, optional) ------------------------------
# Leave the key blank to keep the provider disabled. With no key set, the app
# runs entirely on free sources and never incurs API cost.
AUTODEV_ENABLED=false
AUTODEV_API_KEY=
AUTODEV_BASE_URL=https://auto.dev/api
AUTODEV_TIMEOUT_SECONDS=15
AUTODEV_COST_PER_CALL=0.02        # USD, used for spend reporting only

# --- Cost policy ------------------------------------------------------------
# When true, commercial providers are only called if free providers could not
# supply the required fields (or the caller explicitly asked to verify).
PREFER_FREE_PROVIDERS=true
# Hard ceiling on commercial calls per process lifetime. 0 = unlimited.
MAX_COMMERCIAL_CALLS_PER_DAY=250

# --- Limits -----------------------------------------------------------------
MAX_VINS_PER_REQUEST=100
DECODE_CONCURRENCY=8

# --- Rate limiting (public API) ---------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60            # requests ...
RATE_LIMIT_WINDOW_SECONDS=60      # ... per this many seconds, per client IP
