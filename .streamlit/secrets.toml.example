# Streamlit Cloud secrets template.
#
# On Streamlit Community Cloud: App -> Settings -> Secrets, and paste the
# contents (without this comment block). Locally, copy this file to
# .streamlit/secrets.toml - which is gitignored and must never be committed.
#
# Every key here is bridged to an environment variable by streamlit_app.py,
# so the names match .env.example exactly.

# --- Database ---------------------------------------------------------------
# Leave unset to use the SQLite fallback. On Streamlit Cloud that cache is
# EPHEMERAL and resets whenever the app restarts. Point this at a managed
# PostgreSQL instance (Neon, Supabase, Railway) to make caching durable.
# DATABASE_URL = "postgresql+psycopg://user:password@host:5432/vin_decoder"

# --- Commercial provider (optional) -----------------------------------------
# Omit both and the app runs entirely on free sources at $0.00.
# AUTODEV_ENABLED = "true"
# AUTODEV_API_KEY = "your-key-here"

# --- Tuning -----------------------------------------------------------------
# CACHE_TTL_HOURS = "720"
# MAX_VINS_PER_REQUEST = "100"
